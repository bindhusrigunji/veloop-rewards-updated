# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# MONGODB_URI (or MONGODB_URL): Connection string to external MongoDB cluster (leave unset for embedded demo sandbox)
MONGODB_URI="mongodb+srv://user:password@cluster0.mongodb.net/veloop_rewards?retryWrites=true&w=majority"

# JWT_SECRET: Strong random cryptographic key (>= 32 chars) required in production
JWT_SECRET="CHANGE_ME_STRONG_RANDOM_JWT_SECRET_MIN_32_CHARS"

# PORT: Server port (defaults to 3000)
PORT=3000
